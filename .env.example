# ==============================================================================
# Franchise Dekho — Environment Configuration Template
# Target Environment: Hostinger Shared Hosting (PHP 8.2+ / MariaDB / Apache)
# ==============================================================================

# ------------------------------------------------------------------------------
# Platform Core
# In production: APP_ENV=production, APP_DEBUG=false, APP_URL=https://<yourdomain>
# ------------------------------------------------------------------------------
APP_NAME="Franchise Dekho"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Kolkata
APP_URL=https://example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# ------------------------------------------------------------------------------
# Logging
# Production logs are rotated daily with a 30-day retention policy.
# Sensitive tokens and passwords are scrubbed before writing.
# ------------------------------------------------------------------------------
LOG_CHANNEL=daily
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null

# ------------------------------------------------------------------------------
# Database (MySQL / MariaDB on Hostinger)
# Replace with cPanel / hPanel generated database credentials.
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u123456789_franchisedekho
DB_USERNAME=u123456789_dbuser
DB_PASSWORD=your_strong_database_password

# ------------------------------------------------------------------------------
# Session Security & Storage
# In production, SESSION_SECURE_COOKIE MUST be true when serving over HTTPS.
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# ------------------------------------------------------------------------------
# Cache & Queues (Database Driver for Shared Hosting Reliability)
# ------------------------------------------------------------------------------
CACHE_STORE=database
CACHE_PREFIX=franchise_dekho_cache_
QUEUE_CONNECTION=database

# ------------------------------------------------------------------------------
# File Storage Disks
# Default disk 'local' isolates customer verification proofs to storage/app/private.
# Public disk stores branded banners, avatars, and guide images.
# ------------------------------------------------------------------------------
FILESYSTEM_DISK=local

# ------------------------------------------------------------------------------
# Mail Delivery (SMTP / Hostinger Mail / Postmark / Resend)
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=operations@example.com
MAIL_PASSWORD=your_mail_password
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="operations@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# Razorpay Payment Gateway (Escrow / Coordinator Retainers)
# Set live keys before accepting production customer transactions.
# ------------------------------------------------------------------------------
RAZORPAY_KEY=rzp_live_xxxxxxxxxxxxxxxx
RAZORPAY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# AI-Assisted Discovery (Task T15)
# Options for AI_DISCOVERY_DRIVER:
#   - grounded_engine : Rule-grounded query parser (zero external API calls, SLA safe)
#   - gemini          : Google Gemini API with verified catalogue grounding
# ------------------------------------------------------------------------------
AI_DISCOVERY_DRIVER=grounded_engine
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# Asset Pipeline & Vite
# ------------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
